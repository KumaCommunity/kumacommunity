{
  // Docusaurus 3.10's preset still sets removed baseUrl. Keep its supported
  // options explicit until upstream removes it; null breaks Playwright's parser.
  // Docusaurus handles transpilation; this config is for checking and editors.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
