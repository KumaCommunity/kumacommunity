{
  // Type checking and editor configuration; Docusaurus handles transpilation.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // Docusaurus 3.10 still sets baseUrl; null clears the removed TS 7 option.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
