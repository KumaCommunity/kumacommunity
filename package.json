{
  "name": "kumacommunity",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "playwright test",
    "test:e2e": "npm run build && playwright test",
    "test:visual": "KUMA_VISUAL=1 npm run test:e2e -- --grep \"Visual regression\"",
    "check": "npm run typecheck && npm run build && npm run test:e2e",
    "audit": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "compression": "1.8.2",
    "fast-uri": "3.1.9",
    "joi": "17.13.9",
    "launch-editor": "2.14.2",
    "lodash": "4.18.1",
    "picomatch": "^2.3.2",
    "proxy-addr": "2.0.8",
    "serialize-javascript": "7.1.4",
    "shell-quote": "1.12.0",
    "tinypool": "2.1.2",
    "websocket-driver": "0.7.5",
    "express": {
      "path-to-regexp": "0.1.13",
      "qs": "6.16.2"
    },
    "webpack-dev-server": "^5.2.7",
    "http-proxy-middleware": "^2.0.10",
    "webpack-bundle-analyzer": {
      "ws": "7.5.14"
    }
  }
}
